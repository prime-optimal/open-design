ARG OPEN_DESIGN_BASE_IMAGE=harbor.usw-1.sealos.io/ns-sjkkuwc0/stream-machine@sha256:a3aa28203c12996188a2e9ad9037392e1207e719ef33a708abaa8ed7dfc0b50b
FROM ${OPEN_DESIGN_BASE_IMAGE}

USER 0:0
ARG CHROMIUM_VERSION=155.0.8059.84-r0
RUN apk add --no-cache "chromium=${CHROMIUM_VERSION}" ffmpeg && \
    test -x /usr/lib/chromium/chromium && command -v ffmpeg && command -v ffprobe && \
    mkdir -p /home/open-design/.config /home/open-design/.cache /home/open-design/.hyperframes && \
    chown -R 1001:1001 /home/open-design && chmod 700 /home/open-design
ENV HYPERFRAMES_BROWSER_PATH=/usr/lib/chromium/chromium
USER 1001:1001
RUN "$HYPERFRAMES_BROWSER_PATH" --version
